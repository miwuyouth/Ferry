{
  "name": "ferry",
  "productName": "Ferry",
  "version": "1.0.0",
  "description": "macOS 上的 frp 客户端 —— 托管 frpc 进程，把配置变成表单，在菜单栏显示实时状态。",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "author": "miwuyouth <miwuyouth@gmail.com>",
  "scripts": {
    "start": "node scripts/patch-electron-plist.js && electron .",
    "postinstall": "node scripts/patch-electron-plist.js",
    "icons": "node scripts/make-icons.js",
    "dist": "electron-builder --mac"
  },
  "build": {
    "appId": "dev.ferry.app",
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.15.3"
  }
}
