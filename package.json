{
  "name": "ferry",
  "productName": "Ferry",
  "version": "1.0.3",
  "description": "跨平台 frp 客户端 —— 托管 frpc 进程，把配置变成表单，在菜单栏/托盘显示实时状态。",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "author": "miwuyouth <miwuyouth@gmail.com>",
  "scripts": {
    "start": "node scripts/patch-electron-plist.js && electron .",
    "postinstall": "node scripts/patch-electron-plist.js",
    "icons": "node scripts/make-icons.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -mwl"
  },
  "build": {
    "appId": "dev.ferry.app",
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "miwuyouth",
      "repo": "Ferry",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ferry"
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.15.3"
  }
}
